# Copy this file to .env.local and fill in your real values.
# Never commit .env.local

# Neon Postgres — Project → Connection Details → Connection string
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Zoho CPaaS / ZeptoMail — Agent → SMTP/API tab
# Host shown in dashboard (usually cpaas.zoho.com)
ZEPTOMAIL_HOST="cpaas.zoho.com"
# API key from "API Setup" (the part after Zoho-enczapikey, or the full string)
ZEPTOMAIL_TOKEN="Zoho-enczapikey wSsVR61z8hHwBqt+zWGrLrw5zV0GUl30EU542FqkvSX6GPqQ8sdqkBCbBgPxHfMaQmE8HDITp7x6zBwH12Bajo4qm1oCDiiF9mqRe1U4J3x17qnvhDzIXmtZkReOKIgJwAlvkmFgF80l+g=="
# Must use a sender on your verified domain (e.g. @protechtengineering.com)
ZEPTOMAIL_FROM_EMAIL="noreply@protechtengineering.com"
ZEPTOMAIL_FROM_NAME="Ctrl School"

# Team inbox for new application alerts
ADMIN_EMAIL="Ctrlschoolafrica@gmail.com"

# Only if Neon fails with UNABLE_TO_VERIFY_LEAF_SIGNATURE on your PC
# ALLOW_INSECURE_TLS=1
